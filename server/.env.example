# ===== Real Server 配置（复制为 .env 使用）=====

# HTTP 服务（2026-09-04：端口 8933→8943，避免与其他本地服务端口撞车）
REAL_HOST=127.0.0.1
REAL_PORT=8943

# 数据库（SQLite 文件路径）
# 默认**不设这一行** —— 库会落在「数据根」，按下列优先级解析：
#   REAL_DATA_DIR  >  设置面板标记  >  %APPDATA%/real-agent  >  <项目根>/.real/
# 只有想把库放到别处时才取消注释。注意：填相对路径会落到「后端的工作目录」
# （开发时就是 server/），那样仓库里会一直躺着一个 real.db，不建议。
# REAL_DATABASE_URL=sqlite://real.db

# DeepSeek Responses API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认模型（规格名）。退役旧名会被 config::normalize_model_name 自动改写并告警，
# 但请直接写当前名，避免启动日志出现「模型已退役」的噪音。
REAL_LLM_MODEL=deepseek-flash

# LLM 模式：mock = 内置假模型（无 Key 可跑通全流程）| real = 真实调用
# （客户端壳拉起后端时会强制注入 REAL_LLM_MODE=real）
# 没有 API Key 想先跑通全流程：取消下面一行的注释
# REAL_LLM_MODE=mock

# ---- 模型调用参数 ----
# 单次输出 token 上限
REAL_MAX_OUTPUT_TOKENS=393216
# 思考模式：none(关，默认) | low | medium | high
REAL_THINKING_MODE=none
REAL_THINKING_EFFORT=none

# ---- 上下文压缩 ----
REAL_COMPACT_TRIGGER=
REAL_COMPACT_KEEP_RAW=
REAL_COMPACT_COOLDOWN_SECS=

# ---- 并发 ----
# SQLite 连接池上限（默认 64）
REAL_DB_POOL_MAX=64

# ---- 视频生产引擎（视频工具域） ----
# 引擎根目录；Python 解释器（需引擎全套依赖，缺省自动探测）
# REAL_VIDEO_ROOT=<引擎根目录，不填则自动探测>
# REAL_VIDEO_PYTHON=C:/path/to/python.exe

# 日志级别
RUST_LOG=info
