# ===== Real Server 配置（复制为 .env 使用）=====

# HTTP 服务（2026-09-04：端口 8933→8943，避免与其他本地服务端口撞车）
REAL_HOST=127.0.0.1
REAL_PORT=8943

# ---- 设备鉴权（远程访问手机等设备时用；本机回环免鉴权，桌面不受影响）----
# 浏览器来源白名单（逗号分隔）。浏览器对所有非 GET 请求都带 Origin，**手机端的来源必须列进来**
# 否则会被 Origin 守卫 403。例：REAL_ALLOWED_ORIGINS=https://my-pc.tailnet.ts.net
# REAL_ALLOWED_ORIGINS=
# 信任本机反向代理还原真实客户端（默认 0=关）。用在 `tailscale serve` 这类"本机代理"场景：
# 它把请求转发到 127.0.0.1，后端看到的对端是回环 ⇒ 不还原的话手机请求会命中"回环免鉴权"而绕过鉴权。
# 仅当对端是回环时才会采信 X-Forwarded-For 的【最后一个】非回环地址；非回环对端绝不读该头。
# REAL_TRUST_LOCAL_PROXY=0

# ---- 静态前端托管（默认 0=关；开启后后端会把前端也发出去，供手机直接打开网页）----
# 关（默认）：行为与不开启时完全一致——后端不托管静态前端，只有 /api/*。
# 开：非 /api/* 的 GET/HEAD 从 web 根提供静态文件，找不到的路径回落到 index.html（SPA）。
#     静态资源**不需要 token**（否则手机连界面都拿不到）；/api/* 的鉴权口径不变。
# 典型组合：手机访问 https://<主机>.ts.net/  →（tailscale serve 本机代理）→ 后端同时吐出界面与 /api
# REAL_SERVE_WEB=1
# web 根目录（缺省 <项目根>/client/dist，即 vite outDir = Tauri frontendDist 的落点）。
# 后端单独部署、前端目录另放时才需要显式指定。
# REAL_WEB_DIR=D:/Real/client/dist

# 数据库（SQLite 文件路径）
# 默认**不设这一行** —— 库会落在「数据根」，按下列优先级解析：
#   REAL_DATA_DIR  >  设置面板标记  >  %APPDATA%/real-agent  >  <项目根>/.real/
# 只有想把库放到别处时才取消注释。注意：填相对路径会落到「后端的工作目录」
# （开发时就是 server/），那样仓库里会一直躺着一个 real.db，不建议。
# REAL_DATABASE_URL=sqlite://real.db

# DeepSeek Responses API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认模型（规格名）。退役旧名会被 config::normalize_model_name 自动改写并告警，
# 但请直接写当前名，避免启动日志出现「模型已退役」的噪音。
REAL_LLM_MODEL=deepseek-flash

# LLM 模式：mock = 内置假模型（无 Key 可跑通全流程）| real = 真实调用
# （客户端壳拉起后端时会强制注入 REAL_LLM_MODE=real）
# 没有 API Key 想先跑通全流程：取消下面一行的注释
# REAL_LLM_MODE=mock

# ---- 模型调用参数 ----
# 单次输出 token 上限
REAL_MAX_OUTPUT_TOKENS=393216
# 思考模式：none(关，默认) | low | medium | high
REAL_THINKING_MODE=none
REAL_THINKING_EFFORT=none

# ---- 上下文压缩 ----
REAL_COMPACT_TRIGGER=
REAL_COMPACT_KEEP_RAW=
REAL_COMPACT_COOLDOWN_SECS=

# ---- 并发 ----
# SQLite 连接池上限（默认 64）
REAL_DB_POOL_MAX=64

# ---- 视频生产引擎（视频工具域） ----
# 引擎根目录；Python 解释器（需引擎全套依赖，缺省自动探测）
# REAL_VIDEO_ROOT=<引擎根目录，不填则自动探测>
# REAL_VIDEO_PYTHON=C:/path/to/python.exe

# 日志级别
RUST_LOG=info
