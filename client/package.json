  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-port.mjs && vite",
    "build": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\" && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "sidecar": "node scripts/prepare-sidecar.mjs",
    "release": "node scripts/prepare-sidecar.mjs && tauri build",
    "guard": "node scripts/ui-guard.mjs",
    "sim": "node scripts/run-sim.mjs",
    "sim:resume": "node scripts/run-sim.mjs scripts/sim-resume-gate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.11.1",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
